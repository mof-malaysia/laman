{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "HOST",
        "ADMIN_PORT",
        "SERVER_URL",
        "DATA_DIR",
        "LOG_LEVEL",
        "BACKUP_DIR",
        "BACKUP_SECRET_KEY",
        "MEDIA_STORE_ENDPOINT",
        "MEDIA_STORE_ACCESS_KEY_ID",
        "MEDIA_STORE_SECRET_ACCESS_KEY"
      ]
    }
  }
}
