{
  "extends": "@laman/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "entry.d.ts", "paths.d.ts", "astro.config.mjs"],
  "exclude": ["dist"]
}
