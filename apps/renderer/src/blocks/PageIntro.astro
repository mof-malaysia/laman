---
/**
 * The opening of an inner page, in FTDS PageIntro, with the page's breadcrumb,
 * and on a listing, its own search when the block asks for it.
 */
import { bandTone } from "./tone";
import type { BlockOf, Locale } from "@laman/blocks";
import PageIntro from "@/components/blocks/page-intro.astro";
import Tag from "@/components/ui/tag.astro";
import ListingSearch from "@/search/ListingSearch.astro";
import Field from "./Field.astro";

type Props = {
  block: BlockOf<"pageIntro">;
  edit: boolean;
  lang: Locale;
  breadcrumb?: { label: string; href?: string }[] | undefined;
  /** A listing's search: its title, and the category this page shows. */
  search?: { collection: string; category?: string | undefined } | undefined;
};
const { block, edit, lang, breadcrumb, search } = Astro.props;
const p = block.props;
---

<PageIntro
  breadcrumb={breadcrumb}
  {...bandTone(p.tone)}
  width={p.width}
  lang={lang}
>
  {
    (edit || p.eyebrow) && (
      <Tag slot="eyebrow" variant="primary" size="medium">
        <Field name="eyebrow" edit={edit} placeholder="Eyebrow">{p.eyebrow}</Field>
      </Tag>
    )
  }
  <Field slot="title" name="title" edit={edit} placeholder="Title">{p.title}</Field>
  {
    (edit || p.description) && (
      <Field slot="description" name="description" edit={edit} placeholder="Description">
        {p.description}
      </Field>
    )
  }
  {
    search && (
      <ListingSearch
        slot="search"
        collection={search.collection}
        category={search.category}
        placeholder={p.searchPlaceholder}
        lang={lang}
      />
    )
  }
</PageIntro>
