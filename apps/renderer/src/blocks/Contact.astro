---
/**
 * How to reach the agency, in FTDS ContactLocations: the site settings'
 * phone, email and hours as channels, and the office with its address.
 * The block can override any of them.
 */
import type { BlockOf, SiteContext } from "@fiscal-sb/blocks";
import ContactLocations from "@/components/blocks/contact-locations.astro";
import Field from "./Field.astro";

type Props = { block: BlockOf<"contact">; edit: boolean; lang: "ms" | "en"; site: SiteContext };
const { block, edit, lang, site } = Astro.props;
const p = block.props;
const o = p.overrides ?? {};
const address = o.address ?? site.contact.address;
const phone = o.phone ?? site.contact.phone;
const email = o.email ?? site.contact.email;
const hours = o.hours ?? site.contact.hours;

const channels = [
  ...(phone ? [{ kind: "phone" as const, value: phone, detail: hours || undefined }] : []),
  ...(email ? [{ kind: "email" as const, value: email }] : []),
];
const offices = address
  ? [
      {
        name: p.officeName || site.agency || site.name,
        address: address.split("\n").map((line) => line.trim()).filter(Boolean),
        ...(hours && { hours }),
        ...(p.mapUrl && { mapHref: p.mapUrl }),
      },
    ]
  : [];
const empty = !channels.length && !offices.length;
---

{
  empty ? (
    edit && (
      <section class="bg-bg-white">
        <div class="mx-auto flex w-full max-w-[1280px] flex-col gap-4 px-4 py-12 md:px-6">
          <h2 class="text-headline font-semibold">
            <Field name="title" edit={edit} placeholder="Tajuk">{p.title}</Field>
          </h2>
          <p class="bg-bg-washed text-txt-black-700 max-w-[70ch] rounded-md p-6">
            Isi alamat, telefon dan e-mel di Tetapan, atau dalam blok ini.
          </p>
        </div>
      </section>
    )
  ) : (
    <ContactLocations channels={channels} offices={offices} lang={lang}>
      {(p.title || edit) && (
        <Field slot="title" name="title" edit={edit} placeholder="Tajuk">
          {p.title}
        </Field>
      )}
      {(p.description || edit) && (
        <Field slot="description" name="description" edit={edit} placeholder="Pengenalan">
          {p.description}
        </Field>
      )}
    </ContactLocations>
  )
}
