---
/**
 * Days with their events, each under the day's heading: the calendar's agenda
 * and its month on narrow screens. An event shows its time, title, place and
 * category; one running over several days shows its days instead of a time.
 */
import type { EntryItem } from "@fiscal-sb/blocks";
import Tag from "@/components/ui/tag.astro";
import ClockIcon from "@/components/ui/icons/clock.astro";
import PinIcon from "@/components/ui/icons/pin.astro";
import { linked_item_class, stretched_link_class } from "@/components/ui/section.variants";
import { clx } from "@/lib/ftds/utils";
import { dayLabel, dayRange, daysToGo, isMultiDay, timeRange, whereLabel } from "./events";

type Props = { days: { day: string; items: EntryItem[] }[]; today: string; lang: "ms" | "en" };
const { days, today, lang } = Astro.props;
---

<ol class="flex flex-col gap-8">
  {
    days.map(({ day, items }) => {
      const near = daysToGo(today, day, lang);
      return (
        <li class="flex flex-col gap-3">
          <h2 class="text-title text-txt-black-900 flex flex-wrap items-center gap-2 font-semibold">
            <time datetime={day}>{dayLabel(day, lang)}</time>
            {near && (
              <Tag variant={day === today ? "primary" : "default"} size="small">
                {near}
              </Tag>
            )}
          </h2>
          <ul class="flex flex-col gap-3">
            {items.map((item) => {
              const event = item.event!;
              const where = whereLabel(event);
              return (
                <li class={clx(linked_item_class, "bg-bg-white border-otl-gray-200 flex flex-col gap-2 rounded-lg border p-4 md:flex-row md:items-start md:gap-6")}>
                  <p class="text-label-md text-txt-black-700 flex shrink-0 items-center gap-1.5 md:w-48">
                    <ClockIcon class="size-4 shrink-0" aria-hidden="true" />
                    {isMultiDay(event) ? dayRange(event, lang) : timeRange(event, lang)}
                  </p>
                  <div class="flex min-w-0 flex-col gap-1.5">
                    <h3 class="text-txt-black-900 text-body-lg font-semibold text-pretty">
                      <a href={item.href} class={stretched_link_class}>
                        {item.title}
                      </a>
                    </h3>
                    {(where || item.category) && (
                      <p class="text-body-sm text-txt-black-700 flex flex-wrap items-center gap-x-3 gap-y-1">
                        {where && (
                          <span class="inline-flex items-center gap-1">
                            <PinIcon class="size-4 shrink-0" aria-hidden="true" />
                            {where}
                          </span>
                        )}
                        {item.category && (
                          <Tag variant="default" size="small">
                            {item.category}
                          </Tag>
                        )}
                      </p>
                    )}
                    {item.summary && <p class="text-body-sm text-txt-black-700 line-clamp-2">{item.summary}</p>}
                  </div>
                </li>
              );
            })}
          </ul>
        </li>
      );
    })
  }
</ol>
