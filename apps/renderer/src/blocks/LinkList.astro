---
/** Links to pages and other websites, in FTDS LinkList; another website is worked out from the address. */
import type { Column } from "./column";
import type { BlockOf, Locale } from "@laman/blocks";
import LinkList from "@/components/blocks/link-list.astro";
import Field from "./Field.astro";
import { isExternal } from "./links";

type Props = { block: BlockOf<"linkList">; width: Column; edit: boolean; lang: Locale; siteUrl?: string | undefined };
const { block, width, edit, lang, siteUrl } = Astro.props;
const p = block.props;
const links = p.items.map((item) => ({
  label: item.label,
  href: item.href,
  description: item.description,
  external: isExternal(item.href, siteUrl),
}));
---

<LinkList width={width} links={links} layout={p.layout} tone={p.tone} lang={lang}>
  {
    (edit || p.title) && (
      <Field slot="title" name="title" edit={edit} placeholder="Tajuk">{p.title}</Field>
    )
  }
  {
    (edit || p.description) && (
      <Field slot="description" name="description" edit={edit} placeholder="Penerangan">
        {p.description}
      </Field>
    )
  }
</LinkList>
