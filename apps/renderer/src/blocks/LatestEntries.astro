---
/**
 * The newest entries of a listing page, with a link to see them all. Lists
 * and headlines are FTDS NewsList; cards are EntryCards, since NewsList's
 * grid stops at three and this block shows up to twelve.
 *
 * "Show more" sends up to LATEST_MAX entries; ShowMore reveals `count` more
 * per press.
 */
import { type BlockOf, type EntryItem, LATEST_MAX } from "@laman/blocks";
import NewsList from "@/components/blocks/news-list.astro";
import ArrowForwardIcon from "@/components/ui/icons/arrow-forward.astro";
import Link from "@/components/ui/link.astro";
import Section from "@/components/ui/section.astro";
import { isoDay } from "./date";
import EntryCards from "./EntryCards.astro";
import Field from "./Field.astro";
import ShowMore from "./ShowMore.astro";

type Props = {
  block: BlockOf<"latestEntries">;
  edit: boolean;
  lang: "ms" | "en";
  latest?: Record<string, { path: string; items: EntryItem[] }>;
};
const { block, edit, lang, latest } = Astro.props;
const p = block.props;
const count = Number(p.count);
const source = p.listing ? latest?.[p.listing] : undefined;
const items = (source?.items ?? [])
  .filter((item) => !p.category || item.categorySlug === p.category)
  .slice(0, p.showMore ? LATEST_MAX : count)
  .map((item) => ({
    title: item.title,
    href: item.href,
    // An event shows its own day, not the day it was published.
    date: isoDay(item.event?.start ?? item.date),
    ...(item.category && { category: item.category }),
    ...(p.style !== "compact" && item.summary && { summary: item.summary }),
    ...(p.style === "grid" && item.image && { image: item.image }),
  }));
const more = p.showMore && items.length > count;
const viewAll = source && p.seeAll ? { label: p.seeAll, href: p.category ? `${source.path === "/" ? "" : source.path}/kategori/${p.category}` : source.path } : undefined;
// Four or eight sit four to a row; everything else three.
const fourUp = count === 4 || count === 8;
---

{
  items.length > 0 ? (
    <div data-latest-entries={more ? String(count) : undefined}>
      {p.style === "grid" ? (
        <Section tone={p.tone}>
          {(p.title || edit) && (
            <Field slot="title" name="title" edit={edit} placeholder="Tajuk">
              {p.title}
            </Field>
          )}
          {viewAll && (
            <Link slot="aside" href={viewAll.href} primary underline="hover" class="text-label-md inline-flex shrink-0 items-center gap-1.5 font-medium">
              {viewAll.label}
              <ArrowForwardIcon aria-hidden="true" class="size-4" />
            </Link>
          )}
          <EntryCards items={items} lang={lang} columns={fourUp ? 4 : 3} />
          {more && <ShowMore label={p.showMoreText || "Lihat lagi"} />}
        </Section>
      ) : (
        <NewsList items={items} layout={p.style} tone={p.tone} lang={lang} {...(viewAll && { viewAll })}>
          {(p.title || edit) && (
            <Field slot="title" name="title" edit={edit} placeholder="Tajuk">
              {p.title}
            </Field>
          )}
          {more && <ShowMore label={p.showMoreText || "Lihat lagi"} />}
        </NewsList>
      )}
    </div>
  ) : (
    edit && (
      <section class="bg-bg-white">
        <p class="bg-bg-washed text-txt-black-700 mx-auto my-12 max-w-[70ch] rounded-md p-6 text-center">
          {p.listing ? "Belum ada entri yang diterbitkan dalam penyenaraian ini." : "Pilih halaman penyenaraian di panel."}
        </p>
      </section>
    )
  )
}
