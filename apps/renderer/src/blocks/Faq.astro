---
/** Questions and rich-text answers in FTDS Faq; each answer fills its item's slot. */
import { type BlockOf, richTextToHtml } from "@fiscal-sb/blocks";
import Faq from "@/components/blocks/faq.astro";
import Field from "./Field.astro";

type Props = { block: BlockOf<"faq">; edit: boolean; lang: "ms" | "en" };
const { block, edit, lang } = Astro.props;
const p = block.props;
const items = p.items.map((item, i) => ({ value: `faq-${i}`, question: item.question }));
---

<Faq items={items} tone={p.tone} lang={lang}>
  {
    (p.title || edit) && (
      <Field slot="title" name="title" edit={edit} placeholder="Tajuk">
        {p.title}
      </Field>
    )
  }
  {
    (p.description || edit) && (
      <Field slot="description" name="description" edit={edit} placeholder="Pengenalan">
        {p.description}
      </Field>
    )
  }
  {p.items.map((item, i) => <Fragment slot={`faq-${i}`} set:html={richTextToHtml(item.answer)} />)}
</Faq>
