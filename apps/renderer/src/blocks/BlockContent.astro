---
/** The block-to-component map: every registry type renders through one of these wrappers around its FTDS component. */
import type { Block, RenderInput } from "@laman/blocks";
import Callout from "./Callout.astro";
import { columnOf } from "./column";
import Contact from "./Contact.astro";
import CtaBand from "./CtaBand.astro";
import CtaCards from "./CtaCards.astro";
import CtaSplit from "./CtaSplit.astro";
import Details from "./Details.astro";
import DownloadList from "./DownloadList.astro";
import Eligibility from "./Eligibility.astro";
import Embed from "./Embed.astro";
import EntryList from "./EntryList.astro";
import EventCalendar from "./EventCalendar.astro";
import EventDetails from "./EventDetails.astro";
import Faq from "./Faq.astro";
import FeatureGrid from "./FeatureGrid.astro";
import Hero from "./Hero.astro";
import Image from "./Image.astro";
import ImpactStats from "./ImpactStats.astro";
import InsetText from "./InsetText.astro";
import LatestEntries from "./LatestEntries.astro";
import LinkList from "./LinkList.astro";
import LogoCloud from "./LogoCloud.astro";
import PageIntro from "./PageIntro.astro";
import PartnerGrid from "./PartnerGrid.astro";
import PeopleGrid from "./PeopleGrid.astro";
import Prose from "./Prose.astro";
import ServiceHighlights from "./ServiceHighlights.astro";
import StatsBand from "./StatsBand.astro";
import Steps from "./Steps.astro";
import UpcomingEvents from "./UpcomingEvents.astro";

type Props = { block: Block; input: RenderInput };
const { block, input } = Astro.props;
const edit = input.mode === "edit";
const lang = input.locale;
const media = input.media ?? {};
const { site, listing, latest, upcoming, breadcrumb } = input;
/** The column of a block with a width setting (column.ts). */
const column = (b: { props: { width?: "page" | "article" | "wide" } }) => columnOf(b.props.width, input);
---

{block.type === "hero" && <Hero block={block} edit={edit} media={media} />}
{
  block.type === "pageIntro" && (
    <PageIntro
      block={block}
      edit={edit}
      lang={lang}
      breadcrumb={breadcrumb}
      // A listing's own search, when site search is on to answer it
      search={
        block.props.search && listing && site.search
          ? {
              collection: input.page.title,
              category: listing.categories.find((c) => c.slug === listing.category)?.name,
            }
          : undefined
      }
    />
  )
}
{block.type === "prose" && <Prose block={block} width={column(block)} edit={edit} />}
{block.type === "image" && <Image block={block} edit={edit} media={media} />}
{block.type === "featureGrid" && <FeatureGrid block={block} edit={edit} lang={lang} />}
{block.type === "serviceHighlights" && <ServiceHighlights block={block} edit={edit} />}
{block.type === "steps" && <Steps block={block} width={column(block)} edit={edit} lang={lang} />}
{block.type === "eligibility" && <Eligibility block={block} width={column(block)} edit={edit} lang={lang} />}
{block.type === "ctaBand" && <CtaBand block={block} edit={edit} />}
{block.type === "callout" && <Callout block={block} width={column(block)} edit={edit} lang={lang} />}
{block.type === "linkList" && <LinkList block={block} width={column(block)} edit={edit} lang={lang} siteUrl={site.url} />}
{block.type === "downloadList" && <DownloadList block={block} width={column(block)} edit={edit} lang={lang} media={media} />}
{block.type === "peopleGrid" && <PeopleGrid block={block} edit={edit} media={media} />}
{block.type === "faq" && <Faq block={block} width={column(block)} edit={edit} lang={lang} />}
{block.type === "contact" && <Contact block={block} width={column(block)} edit={edit} lang={lang} site={site} />}
{block.type === "entryList" && <EntryList block={block} edit={edit} lang={lang} listing={listing} />}
{block.type === "latestEntries" && <LatestEntries block={block} edit={edit} lang={lang} latest={latest} />}
{block.type === "eventCalendar" && <EventCalendar block={block} edit={edit} lang={lang} listing={listing} />}
{block.type === "upcomingEvents" && <UpcomingEvents block={block} edit={edit} lang={lang} upcoming={upcoming} />}
{block.type === "insetText" && <InsetText block={block} width={column(block)} edit={edit} />}
{block.type === "details" && <Details block={block} width={column(block)} edit={edit} />}
{block.type === "statsBand" && <StatsBand block={block} edit={edit} />}
{block.type === "impactStats" && <ImpactStats block={block} edit={edit} lang={lang} />}
{block.type === "ctaCards" && <CtaCards block={block} edit={edit} />}
{block.type === "ctaSplit" && <CtaSplit block={block} edit={edit} media={media} />}
{block.type === "partnerGrid" && <PartnerGrid block={block} edit={edit} lang={lang} media={media} siteUrl={site.url} />}
{block.type === "logoCloud" && <LogoCloud block={block} edit={edit} media={media} />}
{block.type === "eventDetails" && <EventDetails block={block} width={column(block)} lang={lang} event={input.entry?.event} />}
{block.type === "embed" && <Embed block={block} width={column(block)} edit={edit} live={input.mode === "publish"} lang={lang} rules={site.embeds} />}
