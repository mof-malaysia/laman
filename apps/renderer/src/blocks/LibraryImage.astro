---
/**
 * A picture from the media library: its narrower WebP copies as `srcset`,
 * its size to keep the layout still, and alt text from the block's override
 * or else the library's. `eager` is for the page's largest paint (a hero).
 */
import type { MediaInfo } from "@fiscal-sb/blocks";
import { srcsetOf } from "./media";

type Props = { info: MediaInfo; alt?: string | undefined; sizes: string; eager?: boolean };
const { info, alt, sizes, eager = false } = Astro.props;
const srcset = srcsetOf(info);
---

<img
  src={info.url}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  alt={alt ?? info.alt}
  width={info.width ?? undefined}
  height={info.height ?? undefined}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : undefined}
  decoding="async"
/>
