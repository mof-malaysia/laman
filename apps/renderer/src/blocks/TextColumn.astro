---
/**
 * The page's text column, for blocks that read as part of the text: Text,
 * Callout, Inset text, Details. `tight` is for the short ones set between
 * paragraphs, so they don't open a gap a section's padding would. `width`
 * is the block's column (column.ts): the text column or the wide one.
 */
import { container_cva } from "@/components/ui/section.variants";
import { clx } from "@/lib/ftds/utils";
import type { Column } from "./column";

type Props = { tight?: boolean; width?: Column };
const { tight = false, width = "wide" } = Astro.props;
---

<section class="bg-bg-white">
  <div class={clx(container_cva({ width, flush: true }), "px-4 md:px-6", tight ? "py-6" : "py-12 md:py-16")}>
    <slot />
  </div>
</section>
