---
/**
 * One block of a page, through the block-to-component map (BlockContent). In
 * edit mode it is wrapped in a `data-ftds-block` element the editor selects
 * and reorders.
 */
import type { Block, RenderInput } from "@laman/blocks";
import BlockContent from "./BlockContent.astro";

type Props = { block: Block; input: RenderInput };
const { block, input } = Astro.props;
---

{
  input.mode === "edit" ? (
    <div data-ftds-block={block.id} data-ftds-type={block.type}>
      <BlockContent block={block} input={input} />
    </div>
  ) : (
    <BlockContent block={block} input={input} />
  )
}
