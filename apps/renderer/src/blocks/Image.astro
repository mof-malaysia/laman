---
/**
 * A picture from the media library, in FTDS Figure: a responsive img with its
 * narrower WebP copies, the block's caption and the file's credit. Alt text
 * is the block's override, else the library's. With no file chosen it shows
 * only on the canvas.
 */
import type { BlockOf, MediaInfo } from "@laman/blocks";
import Figure from "@/components/blocks/figure.astro";
import Field from "./Field.astro";
import LibraryImage from "./LibraryImage.astro";
import MediaPlaceholder from "./MediaPlaceholder.astro";

type Props = { block: BlockOf<"image">; edit: boolean; media: Record<string, MediaInfo> };
const { block, edit, media } = Astro.props;
const p = block.props;
const info = p.image ? media[p.image.mediaId] : undefined;
const width = p.width === "content" ? "article" : p.width;
const sizes = { content: "(min-width: 768px) 70ch, 100vw", wide: "(min-width: 1280px) 1280px, 100vw", full: "100vw" }[p.width];
---

{
  (info || edit) && (
    <Figure width={width} tone={p.tone} credit={info?.credit || undefined}>
      {info ? (
        <LibraryImage info={info} alt={p.image?.alt} sizes={sizes} />
      ) : (
        <MediaPlaceholder label="Pilih gambar dari Media" />
      )}
      {(p.caption || edit) && (
        <Field slot="caption" name="caption" edit={edit} placeholder="Kapsyen">{p.caption}</Field>
      )}
    </Figure>
  )
}
