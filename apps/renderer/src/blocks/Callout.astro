---
import type { BlockOf } from "@fiscal-sb/blocks";
import Button from "@/components/ui/button.astro";
import Callout from "@/components/ui/callout.astro";
import { action } from "./action";
import Field from "./Field.astro";
import TextColumn from "./TextColumn.astro";

type Props = { block: BlockOf<"callout">; edit: boolean; lang: "ms" | "en" };
const { block, edit, lang } = Astro.props;
const p = block.props;
const link = action(p.action);
---

<TextColumn tight>
  <Callout variant={p.variant} lang={lang}>
    <Field slot="title" name="title" edit={edit} placeholder="Title">{p.title}</Field>
    {
      (edit || p.body) && (
        <Field name="body" edit={edit} placeholder="Text">{p.body}</Field>
      )
    }
    {
      link && (
        <Button slot="actions" variant="default-outline" size="small" href={link.href}>
          {link.label}
        </Button>
      )
    }
  </Callout>
</TextColumn>
