---
/**
 * The search page (SEARCH_PATH): a form that works as a plain GET (?q=), and
 * a script that answers it from the Pagefind index. Pinned results
 * (carian/pins.json) come first when the query is one of their words. Without
 * JavaScript the page says so and offers the site's main sections instead.
 * Results and filters are copies of templates, filled with text, so the FTDS
 * components draw them and nothing from the index becomes HTML but Pagefind's
 * own highlighted excerpt (pagefind.ts). With the filter tickboxes off, a
 * collection and category in the address still narrow it: a listing's own
 * search sends them when it can't search in place.
 */
import { type RenderInput, SEARCH_INDEX_DIR, SEARCH_PATH } from "@laman/blocks";
import PageIntro from "@/components/blocks/page-intro.astro";
import Button from "@/components/ui/button.astro";
import Link from "@/components/ui/link.astro";
import Search from "@/components/ui/icons/search.astro";
import { container_cva } from "@/components/ui/section.variants";
import Results from "./Results.astro";

type Props = { input: RenderInput };
const { input } = Astro.props;
const sections = input.site.nav.flatMap((item) => (item.href ? [{ label: item.label, href: item.href }] : []));
---

<PageIntro breadcrumb={[{ label: "Utama", href: "/" }, { label: "Carian" }]} title="Carian" lang={input.locale} />
<div
  class={container_cva({ width: "article" })}
  data-search
  data-index={`/${SEARCH_INDEX_DIR}/pagefind.js`}
  data-pins={`${SEARCH_PATH}/pins.json`}
  data-filters={input.searchPage?.filters ? "" : undefined}
>
  <form action={SEARCH_PATH} method="get" role="search" class="flex flex-col gap-6" data-search-form>
    <div class="flex flex-col gap-2">
      <label for="carian-q" class="text-body-md text-txt-black-900 font-medium">Cari dalam laman ini</label>
      <div class="flex gap-2">
        {/* FTDS has no Astro input yet: its tokens, as the admin's Input uses them. */}
        <input
          id="carian-q"
          type="search"
          name="q"
          maxlength="100"
          autocomplete="off"
          class="border-otl-control bg-bg-white text-txt-black-900 focus-visible:ring-fr-primary focus-visible:border-otl-primary-300 text-body-md h-(--ctl-h-md) w-full min-w-0 rounded-md border px-3 outline-none focus-visible:ring"
        />
        <Button type="submit" variant="primary-fill" size="medium">
          <Search aria-hidden="true" />
          Cari
        </Button>
      </div>
    </div>
    <fieldset class="m-0 hidden flex-col gap-3 border-0 p-0" data-search-filter-set>
      <legend class="text-body-sm text-txt-black-700 mb-2 font-medium">Tapis hasil</legend>
      <div class="flex flex-wrap gap-x-6 gap-y-2" data-search-filter-list></div>
    </fieldset>
  </form>

  <noscript>
    <div class="text-body-md text-txt-black-700 flex flex-col gap-3">
      <p>Carian memerlukan JavaScript. Hidupkan JavaScript dalam pelayar anda, atau mulakan dari bahagian utama laman:</p>
      {
        sections.length > 0 && (
          <ul class="m-0 flex list-disc flex-col gap-1 pl-5">
            {sections.map((s) => (
              <li>
                <Link href={s.href} primary>
                  {s.label}
                </Link>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </noscript>

  <Results />
  <template data-search-group>
    <div class="flex flex-col gap-2">
      <p class="text-body-sm text-txt-black-500 m-0" data-label></p>
    </div>
  </template>
  <template data-search-option>
    <div class="flex items-center gap-2">
      <input type="checkbox" class="accent-bg-primary-600 size-4" />
      <label class="text-body-sm text-txt-black-700"></label>
    </div>
  </template>
</div>

<script>
  import { loadPagefind, type Pagefind, type Pin, resultList } from "./pagefind";


  const root = document.querySelector<HTMLElement>("[data-search]")!;
  const form = root.querySelector<HTMLFormElement>("[data-search-form]")!;
  const field = form.elements.namedItem("q") as HTMLInputElement;
  const filterSet = root.querySelector<HTMLElement>("[data-search-filter-set]")!;
  const filterList = root.querySelector<HTMLElement>("[data-search-filter-list]")!;
  const results = resultList(root);
  const copy = (name: string) =>
    (root.querySelector<HTMLTemplateElement>(`[data-search-${name}]`)!.content.firstElementChild as HTMLElement).cloneNode(
      true,
    ) as HTMLElement;
  const groups = { koleksi: "Koleksi", kategori: "Kategori" };

  /** The pinned results, fetched once; none when they can't be. */
  let pinsLoading: Promise<Record<string, Pin>> | undefined;
  const pins = () =>
    (pinsLoading ??= fetch(root.dataset.pins!)
      .then((r) => (r.ok ? r.json() : {}))
      .catch(() => ({})));

  /** With the tickboxes off, the collection and category the address names. */
  const fromAddress = Object.fromEntries(
    Object.keys(groups).flatMap((key) => {
      const values = new URLSearchParams(location.search).getAll(key);
      return values.length ? [[key, values]] : [];
    }),
  );

  const chosen = () => {
    if (!("filters" in root.dataset)) return fromAddress;
    const out: Record<string, string[]> = {};
    for (const box of filterList.querySelectorAll<HTMLInputElement>("input:checked"))
      (out[box.name] ??= []).push(box.value);
    return out;
  };

  /** Checkboxes for every collection and category in the index, ticked from the address; once. */
  async function buildFilters(pagefind: Pagefind, params: URLSearchParams) {
    if (!("filters" in root.dataset) || filterList.childElementCount) return;
    const all = await pagefind.filters();
    for (const [key, label] of Object.entries(groups)) {
      // A new array, and toSorted() is missing from the older Android browsers many visitors use.
      // oxlint-disable-next-line unicorn/no-array-sort
      const values = Object.keys(all[key] ?? {}).sort((a, b) => a.localeCompare(b, "ms"));
      if (values.length < 2) continue;
      const group = copy("group");
      group.querySelector("[data-label]")!.textContent = label;
      for (const [i, value] of values.entries()) {
        const option = copy("option");
        const box = option.querySelector("input")!;
        const name = option.querySelector("label")!;
        box.id = name.htmlFor = `carian-${key}-${i}`;
        box.name = key;
        box.value = name.textContent = value;
        box.checked = params.getAll(key).includes(value);
        group.append(option);
      }
      filterList.append(group);
    }
    if (filterList.childElementCount) {
      filterSet.classList.replace("hidden", "flex");
      filterList.addEventListener("change", () => void run(true));
    }
  }

  /** Searches for what the form says; `push` puts the query and filters in the address. */
  async function run(push: boolean) {
    const q = field.value.trim();
    const id = results.start(q ? "Mencari…" : "");
    if (!q) {
      if (push) history.replaceState(null, "", form.action);
      return;
    }
    let pagefind: Pagefind;
    let pinned: Record<string, Pin>;
    try {
      [pagefind, pinned] = await Promise.all([loadPagefind(root.dataset.index!), pins()]);
    } catch {
      results.fail(id);
      return;
    }
    // The first search builds the tickboxes from the address; every one after reads them.
    await buildFilters(pagefind, new URLSearchParams(location.search));
    const filters = chosen();
    if (push) {
      const params = new URLSearchParams({ q });
      for (const [key, values] of Object.entries(filters)) for (const v of values) params.append(key, v);
      history.replaceState(null, "", `${form.action}?${params}`);
    }
    const filter = Object.fromEntries(Object.entries(filters).map(([k, v]) => [k, { any: v }]));
    const search = await pagefind.search(q, Object.keys(filter).length ? { filters: filter } : {});
    if (!search) return;
    await results.show(id, search.results, q, Object.keys(filters).length ? undefined : pinned[q.toLowerCase()]);
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    void run(true);
  });

  field.value = new URLSearchParams(location.search).get("q") ?? "";
  void run(false);
</script>
