---
/** The closing band every page ends on: the primary field again, with the two ways forward. */
import FieldButton from "@/components/home/FieldButton.astro";
import { href, type Link, pageColumn, sectionTitle } from "@/site";

interface Props {
  cta: { title: string; text: string; primary: Link; secondary: Link };
  /** Replaces the second way forward: the contact page offers GitHub instead of itself. */
  secondary?: Link;
}
const { cta, secondary = cta.secondary } = Astro.props;
---

<section class="on-field bg-bg-field text-txt-white" aria-labelledby="cta-title">
  <div class:list={[pageColumn, "flex flex-col gap-8 py-16 md:flex-row md:items-end md:justify-between md:py-20"]}>
    <div class="max-w-[40rem]">
      <h2 id="cta-title" class={sectionTitle}>{cta.title}</h2>
      <p class="text-txt-on-field text-body-lg mt-3">{cta.text}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <FieldButton href={href(cta.primary.href)}>{cta.primary.label}</FieldButton>
      <FieldButton href={href(secondary.href)} variant="quiet">{secondary.label}</FieldButton>
    </div>
  </div>
</section>
