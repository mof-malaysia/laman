---
/**
 * The architecture as the page's opening figure: everything Laman keeps sits
 * inside the agency's data centre, and only the published HTML crosses out to
 * the public. The switch turns the builder off, and the site stays up, which
 * is the point. Without JavaScript the figure still reads; only the switch
 * needs it, so it starts hidden.
 */
import type { CollectionEntry } from "astro:content";
import CrossCircle from "@/components/ui/icons/cross-circle.astro";
import Database from "@/components/ui/icons/database.astro";
import Document from "@/components/ui/icons/document.astro";
import EyeShow from "@/components/ui/icons/eye-show.astro";
import Globe from "@/components/ui/icons/globe.astro";
import Folder from "@/components/ui/icons/folder.astro";
import UserGroup from "@/components/ui/icons/user-group.astro";

interface Props {
  d: CollectionEntry<"home">["data"]["diagram"];
}
const { d } = Astro.props;
const inside = [
  { ...d.builder, icon: UserGroup, part: "builder" },
  { ...d.database, icon: Database, part: "store" },
  { ...d.backups, icon: Folder, part: "store" },
  { ...d.audit, icon: Document, part: "store" },
];
---

<figure class="boundary" data-state="on" aria-label={d.label}>
  <div class="grid gap-0 md:grid-cols-[minmax(0,1fr)_7rem_minmax(0,12.5rem)] md:items-start">
    <div class="border-otl-on-field rounded-[20px] border-2 border-dashed p-4 md:p-5">
      <p class="text-txt-on-field text-label-sm mb-4 font-semibold">{d.boundary}</p>
      <ul class="grid grid-cols-2 gap-2.5 md:gap-3" role="list">
        {
          inside.map(({ title, text, icon: Icon, part }) => (
            <li class="node bg-bg-white text-txt-black-900 rounded-xl p-3 md:p-4" data-part={part}>
              <div class="flex items-start justify-between gap-3">
                <Icon class="text-txt-primary size-5 shrink-0" aria-hidden="true" />
                {part === "builder" && (
                  <span class="off-tag bg-bg-washed text-txt-black-700 text-label-sm rounded-full px-2">
                    {d.offState}
                  </span>
                )}
              </div>
              <p class="text-label-md mt-2 font-semibold md:mt-3">{title}</p>
              <p class="text-body-sm text-txt-black-700 mt-1">{text}</p>
            </li>
          ))
        }
        <li class="node bg-bg-primary-50 text-txt-black-900 col-span-2 rounded-xl p-3 md:p-4" data-part="site">
          <Globe class="text-txt-primary size-5" aria-hidden="true" />
          <p class="text-label-md mt-3 font-semibold">{d.site.title}</p>
          <p class="text-body-sm text-txt-black-700 mt-1">{d.site.text}</p>
        </li>
      </ul>
      <button
        type="button"
        class="switch focus-ring text-txt-white text-label-md mt-4 inline-flex items-center gap-3 rounded-md py-1 pr-2 font-medium"
        aria-pressed="false"
        hidden
      >
        <span class="track bg-bg-white/25 relative inline-block h-6 w-10 rounded-full" aria-hidden="true">
          <span class="knob bg-bg-white absolute top-1 left-1 size-4 rounded-full"></span>
        </span>
        {d.switchOff}
      </button>
    </div>

    <div class="connector text-txt-white relative flex h-16 items-center justify-center md:mt-14 md:h-[6.5rem]" aria-hidden="true">
      <span class="line bg-bg-white absolute top-0 left-1/2 h-full w-[3px] -translate-x-1/2 md:top-1/2 md:left-0 md:h-[3px] md:w-full md:translate-x-0 md:-translate-y-1/2"></span>
      <span class="bg-bg-stage text-label-sm relative px-1.5 font-semibold whitespace-nowrap md:-translate-y-5 md:bg-transparent md:px-0">{d.connector}</span>
    </div>

    <div class="md:mt-14">
      <div class="node bg-bg-white text-txt-black-900 rounded-xl p-4" data-part="public">
        <EyeShow class="text-txt-primary size-5" aria-hidden="true" />
        <p class="text-label-md mt-3 font-semibold">{d.public.title}</p>
        <p class="text-body-sm text-txt-black-700 mt-1">{d.public.text}</p>
      </div>
      <p class="text-txt-on-field text-label-sm mt-6 font-semibold">{d.outsideLabel}</p>
      <ul class="mt-3 flex flex-col gap-2.5" role="list">
        {
          d.outside.map((name) => (
            <li class="text-txt-on-field text-body-sm decoration-otl-refused flex items-center gap-2.5 line-through decoration-2">
              <CrossCircle class="text-otl-refused size-5 shrink-0" aria-hidden="true" />
              {name}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <p class="note text-txt-on-field text-body-sm mt-5" aria-live="polite" data-on={d.onNote} data-off={d.offNote}>
    {d.onNote}
  </p>
</figure>

<style>
  .node {
    transition: background-color 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Off: the builder and what it keeps go quiet (a Blue 200 tile, grey icon);
     their text stays full contrast, and the site and the public stay as they were. */
  .boundary[data-state="off"] [data-part="builder"],
  .boundary[data-state="off"] [data-part="store"] {
    background-color: rgb(var(--_primary-200));
  }
  .boundary[data-state="off"] [data-part="builder"] svg,
  .boundary[data-state="off"] [data-part="store"] svg {
    color: rgb(var(--txt-black-500));
  }
  .off-tag {
    display: none;
  }
  .boundary[data-state="off"] .off-tag {
    display: inline-block;
  }
  .knob {
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .switch[aria-pressed="true"] .knob {
    transform: translateX(1rem);
    background: var(--color-bg-field);
  }
  .switch[aria-pressed="true"] .track {
    background: var(--color-bg-white);
  }
  /* The connector draws once, from the data centre out to the public. */
  /* It starts as a visible stub, so the line is never missing, only drawing. */
  .line {
    transform-origin: top;
    animation: draw-down 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @media (width >= 48rem) {
    .line {
      transform-origin: left;
      animation-name: draw-across;
    }
  }
  @keyframes draw-down {
    from {
      scale: 1 0.3;
    }
  }
  @keyframes draw-across {
    from {
      scale: 0.3 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .line {
      animation: none;
    }
    .node,
    .knob {
      transition: none;
    }
  }
</style>

<script>
  for (const figure of document.querySelectorAll<HTMLElement>(".boundary")) {
    const button = figure.querySelector<HTMLButtonElement>(".switch")!;
    const note = figure.querySelector<HTMLElement>(".note")!;
    button.hidden = false;
    button.addEventListener("click", () => {
      const off = figure.dataset.state !== "off";
      figure.dataset.state = off ? "off" : "on";
      button.setAttribute("aria-pressed", String(off));
      note.textContent = (off ? note.dataset.off : note.dataset.on) ?? "";
    });
  }
</script>
