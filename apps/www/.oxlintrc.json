{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@fiscal-sb/oxlint-config/node.json"],
  "rules": {
    // CSS and font imports are side effects by design.
    "import/no-unassigned-import": "off"
  },
  // FTDS files stay as the registry ships them; .astro/ is generated.
  "ignorePatterns": [
    ".astro/**",
    "src/components/ui",
    "src/components/blocks",
    "src/lib/ftds",
    "styles/ftds.css"
  ]
}
