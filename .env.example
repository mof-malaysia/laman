# Settings for `docker compose` (compose.yaml). Copy to .env beside it and
# fill in. What each server setting does, and the ones not listed here, is
# in apps/server/.env.example; this file adds only what Docker needs.

# The first account (required on the first start; remove afterwards).
SUPER_ADMIN_USERNAME=pentadbir
SUPER_ADMIN_PASSWORD=

# The site's public address. With the https profile, Caddy gets the
# certificate for its host name.
SITE_URL=https://www.agensi.gov.my

# --- Docker only: on the host, not in the container -----------------------
# The host folder backups go to: another disk, copied off the machine. It
# must be writable by uid 1000.
BACKUP_PATH=./backups
# Where the builder listens on the host, for a proxy on this machine. Keep
# 127.0.0.1: the builder believes X-Forwarded-For from any private address
# (TRUST_PROXY=uniquelocal), so a port open to the network lets anyone fake
# their address in the audit log and get round the sign-in limits.
# BIND_ADDRESS=127.0.0.1
# HTTP_PORT=8080

# --- Optional server settings (apps/server/.env.example) ------------------
# TRUST_PROXY=uniquelocal
# BACKUP_SCHEDULE=02:00
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# Needed for off-site copies (Settings -> Backups): `openssl rand -base64 48`.
# BACKUP_SECRET_KEY=
# MEDIA_MAX_MB=10
# LOG_LEVEL=info
# GEOIP_DB=/data/dbip-country-lite.mmdb
