{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Everything in .gitignore is skipped too.
  "ignorePatterns": [
    // FTDS files are installed by the shadcn CLI; keep them as the registry
    // ships them so upgrades diff cleanly.
    "apps/admin/src/components/ui",
    "apps/admin/src/components/blocks",
    "apps/admin/src/lib/ftds",
    "apps/admin/styles/ftds.css",
    "apps/renderer/src/components/ui",
    "apps/renderer/src/components/blocks",
    "apps/renderer/src/lib/ftds",
    "apps/renderer/styles/ftds.css",
    "pnpm-lock.yaml"
  ]
}
